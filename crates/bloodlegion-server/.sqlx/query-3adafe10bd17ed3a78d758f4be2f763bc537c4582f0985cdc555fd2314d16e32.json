{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT r.rank, r.name, r.site_rank AS \"site_rank: Rank\",\n               (SELECT count(*) FROM characters c\n                WHERE c.guild = r.guild AND c.guild_rank = r.rank)\n                   AS \"characters!\"\n        FROM guild_ranks r\n        WHERE r.guild = (SELECT guild_name FROM guild_settings)\n        ORDER BY r.rank\n        ",
