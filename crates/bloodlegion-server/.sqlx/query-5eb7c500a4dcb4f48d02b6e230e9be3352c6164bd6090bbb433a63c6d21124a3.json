  "query": "\n        SELECT r.id, r.zone, r.title, r.starts_at,\n               (SELECT count(*) FROM raid_attendees a WHERE a.raid_id = r.id) AS \"attendee_count!\",\n               (SELECT count(*) FROM loot l WHERE l.raid_id = r.id) AS \"loot_count!\"\n        FROM raids r\n        WHERE r.id = $1\n        ",
