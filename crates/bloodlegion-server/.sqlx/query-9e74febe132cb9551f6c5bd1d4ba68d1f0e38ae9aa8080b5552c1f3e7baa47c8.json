  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.id, i.name, i.quality, i.game_item_id, g.icon AS \"icon?\",\n               (SELECT count(*) FROM loot l WHERE l.item_id = i.id) AS \"drops!\"\n        FROM items i\n        LEFT JOIN game_items g ON g.id = i.game_item_id\n        WHERE i.id = $1\n        ",
