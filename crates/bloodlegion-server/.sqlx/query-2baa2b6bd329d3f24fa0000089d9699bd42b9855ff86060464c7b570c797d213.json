  "query": "\n        SELECT a.user_id AS \"user_id: UserId\", u.username, a.choice, a.updated_at\n        FROM question_answers a\n        JOIN users u ON u.id = a.user_id\n        WHERE a.question_id = $1\n        ORDER BY a.choice DESC, u.username_normalized\n        ",
