  "query": "\n        UPDATE auth_oauth2_client_refresh_tokens\n        SET consumed_at = now()\n        WHERE token_hash = $1\n            AND client_id = $2\n            AND consumed_at IS NULL\n            AND revoked_at IS NULL\n            AND expires_at > now()\n        RETURNING user_id AS \"user_id: UserId\", scope AS \"scope: Scope\", family_id\n        ",
