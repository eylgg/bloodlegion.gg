  "query": "\n        SELECT c.id, c.user_id AS \"user_id: UserId\", u.username AS \"username?\", c.first_name,\n               c.last_name, c.class, c.is_main, c.created_at, c.updated_at\n        FROM characters c\n        LEFT JOIN users u ON u.id = c.user_id\n        WHERE c.id = $1\n        ",
