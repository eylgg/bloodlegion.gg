{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            created_at,\n            last_used_at,\n            ip_address AS \"ip_address: IpNet\",\n            user_agent,\n            (token_hash = $2) AS \"is_current!\"\n        FROM auth_sessions\n        WHERE user_id = $1\n            AND expires_at > now()\n            AND revoked_at IS NULL\n        ORDER BY last_used_at DESC\n        ",
