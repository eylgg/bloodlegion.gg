  "query": "\n        SELECT u.username, c.class, c.specs, c.is_main\n        FROM launch_characters c\n        JOIN users u ON u.id = c.user_id\n        WHERE u.disabled_at IS NULL\n        ORDER BY u.username_normalized, c.is_main DESC, c.class\n        ",
