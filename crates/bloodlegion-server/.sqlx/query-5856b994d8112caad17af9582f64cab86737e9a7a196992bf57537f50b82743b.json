  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.message_id, u.username, a.content, a.mentions, a.posted_at, a.edited_at\n        FROM discord_announcements a\n        JOIN users u ON u.id = a.user_id\n        ORDER BY a.posted_at DESC, a.message_id DESC\n        LIMIT $1\n        ",
