  "query": "\n        SELECT id, name, quality, item_level, required_level, slot, item_subclass, icon\n        FROM game_items\n        WHERE name_normalized LIKE '%' || $1 || '%'\n        ORDER BY name_normalized LIKE $1 || '%' DESC, item_level DESC, name_normalized, id\n        LIMIT $2\n        ",
