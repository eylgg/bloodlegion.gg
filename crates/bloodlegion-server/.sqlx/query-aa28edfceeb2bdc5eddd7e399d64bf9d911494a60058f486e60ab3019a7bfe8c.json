{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.id AS item_id, i.name AS item_name, i.quality AS item_quality, i.game_item_id,\n               count(*) AS \"count!\"\n        FROM loot l\n        JOIN items i ON i.id = l.item_id\n        WHERE l.boss_id = $1\n        GROUP BY i.id\n        ORDER BY count(*) DESC, i.name_normalized\n        ",
