  "query": "\n        SELECT i.id, i.name, i.quality, i.game_item_id,\n               (SELECT count(*) FROM loot l WHERE l.item_id = i.id) AS \"drops!\"\n        FROM items i\n        WHERE i.id = $1\n        ",
