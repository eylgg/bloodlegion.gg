  "query": "\n        SELECT\n            users.id AS \"user_id: UserId\",\n            users.username,\n            auth_local_credentials.created_at,\n            auth_local_credentials.updated_at\n        FROM users\n        JOIN auth_local_credentials ON users.id = auth_local_credentials.user_id\n        ORDER BY users.username\n        ",
