  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.upload_id, a.character_id, c.first_name, c.last_name, c.class, a.revealed\n        FROM roster_added a\n        JOIN characters c ON c.id = a.character_id\n        WHERE a.upload_id = ANY($1)\n        ORDER BY c.name_normalized\n        ",
